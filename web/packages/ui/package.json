{
  "name": "@braswelljr/algorithm-ui",
  "version": "0.0.0",
  "private": true,
  "description": "The alGOrithm site's component library: Base UI primitives in the shadcn base-vega style, synced from gsl-certificates and gnux, plus the algorithm-specific pieces.",
  "author": "braswelljr (https://braswelljr.vercel.app)",
  "homepage": "https://algorithm.vercel.app",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./algorithm/command-palette-filter": "./src/algorithm/command-palette-filter.ts",
    "./algorithm/*": "./src/algorithm/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/highlighter": "./src/lib/highlighter.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "colors": "node scripts/colors.ts"
  },
  "peerDependencies": {
    "next-themes": ">=0.4",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "react-resizable-panels": "4.18.0",
    "shiki": "4.6.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  }
}
