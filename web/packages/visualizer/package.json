{
  "name": "@braswelljr/algorithm-visualizer",
  "version": "0.1.0",
  "description": "Watch real algorithms and data structures run, step by step: React components over the alGOrithm Go library compiled to WebAssembly.",
  "keywords": [
    "algorithms",
    "data-structures",
    "visualization",
    "react",
    "webassembly",
    "sorting",
    "pathfinding"
  ],
  "license": "MIT",
  "author": "braswelljr (https://braswelljr.vercel.app)",
  "homepage": "https://algorithm.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braswelljr/alGOrithm.git",
    "directory": "web/packages/visualizer"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "pnpm build && node scripts/check-assets.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "bugs": "https://github.com/braswelljr/alGOrithm/issues"
}
