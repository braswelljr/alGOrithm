{
  "name": "algorithm-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The alGOrithm site: the visualizer, the docs, learning paths and the quiz, running the Go code as WebAssembly.",
  "author": "braswelljr (https://braswelljr.vercel.app)",
  "homepage": "https://algorithm.vercel.app",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "format": "prettier --write \"**/*.{js,mjs,ts,jsx,tsx,md,css,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,jsx,tsx,md,css,json}\"",
    "icons": "node scripts/icons.mjs",
    "colors": "node scripts/colors.ts",
    "budget": "node scripts/budget.mjs",
    "wasm": "cd .. && make web/wasm"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.9.0",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.3.4",
    "@codemirror/language": "6.11.3",
    "@codemirror/legacy-modes": "6.5.1",
    "@codemirror/lint": "6.9.1",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@gsap/react": "2.1.2",
    "@lezer/highlight": "1.2.1",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "9.3.1",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "embla-carousel-react": "8.6.0",
    "gsap": "3.15.0",
    "iconsax-reactjs": "0.0.8",
    "lucide-react": "^1.66.0",
    "match-sorter": "8.3.0",
    "mermaid": "12.2.0",
    "motion": "14.9.0",
    "next": "16.4.4",
    "next-themes": "0.4.6",
    "nuqs": "^2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "react-hotkeys-hook": "5.3.3",
    "react-icons": "5.7.0",
    "react-resizable-panels": "4.18.0",
    "shiki": "4.6.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto-serif": "5.2.8",
    "@fontsource/source-sans-3": "5.2.8",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
