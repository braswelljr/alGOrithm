{
  "$schema": "https://json.schemastore.org/prettierrc",
  "endOfLine": "auto",
  "trailingComma": "none",
  "semi": true,
  "singleQuote": true,
  "bracketSameLine": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "useTabs": false,
  "quoteProps": "as-needed",
  "singleAttributePerLine": true,
  "htmlWhitespaceSensitivity": "css",
  "printWidth": 100,
  "tabWidth": 2,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "^react(/.*)?$",
    "^next(/.*)?$",
    "<THIRD_PARTY_MODULES>",
    "^lib(/.*)?$",
    "^types(/.*)?$",
    "^schema(/.*)?$",
    "^([~@])(?!react)(/.*)?$",
    "^[./](?!.*\\.css$)",
    "^([~@])/.*\\.css$",
    "^[./].*\\.css$",
    "^[.]"
  ],
  "tailwindFunctions": [
    "cn",
    "classnames",
    "className",
    "classNames",
    "clsx",
    "ctl",
    "cva",
    "tv"
  ],
  "overrides": [
    {
      "files": "**/*.yml",
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": "Makefile",
      "options": {
        "tabWidth": 4,
        "useTabs": true
      }
    },
    {
      "files": [
        "apps/site/**",
        "packages/ui/**"
      ],
      "options": {
        "tailwindStylesheet": "packages/ui/src/styles/theme.css"
      }
    },
    {
      "files": "packages/visualizer/**",
      "options": {
        "tailwindStylesheet": "packages/visualizer/src/tailwind.css"
      }
    }
  ]
}
